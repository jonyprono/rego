generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  password   String
  role       String   @default("TECHNICIAN")
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reports    Report[]
}

model Report {
  id                  Int          @id @default(autoincrement())
  reportNumber        String       @unique
  date                DateTime
  interventionType    String
  startTime           String
  endTime             String
  duration            Float
  price               Float?
  quarter             String?
  
  // Client details
  clientName          String
  agencyName          String
  clientAddress       String
  clientDepartment    String
  clientCommune       String?
  
  // Observations
  problemsEncountered String?
  situationBefore     String?
  solutionProvided    String?
  situationAfter      String?
  remarks             String?

  // Status: "EN_ATTENTE_SIGNATURE", "VALIDE", "BROUILLON"
  status              String       @default("EN_ATTENTE_SIGNATURE")

  // 1. Signature Technicien REGO
  technicianName      String?
  technicianSignature String?      // Cloudinary URL or base64
  technicianSignedAt  DateTime?

  // 2. Signature Responsable Informatique (selon département)
  itManagerName       String?
  itManagerDepartment String?
  itManagerSignature  String?      // Cloudinary URL or base64
  itManagerSignedAt   DateTime?

  // 3. Validation Client
  clientRepresentative String?
  representativeRole   String?
  validationDate       DateTime?
  clientSignature      String?      // Cloudinary URL
  presencePhotos       String?      // JSON string of URLs

  technicians         Technician[]
  photos              Photo[]

  userId              Int
  user                User         @relation(fields: [userId], references: [id])

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Technician {
  id          Int      @id @default(autoincrement())
  fullName    String
  techId      String
  reportId    Int
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Photo {
  id          Int      @id @default(autoincrement())
  url         String
  type        String   // "presence" or "intervention"
  reportId    Int
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedAt  DateTime @default(now())
}
